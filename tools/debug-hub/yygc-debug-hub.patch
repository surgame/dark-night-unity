+        protected override void OnBind()
+        {
+            Root.AddToClassList("rdh-root"); Root.pickingMode = PickingMode.Ignore;
+            Root.Q("debugHubRoot").RemoveFromClassList("rdh-hidden");
+            window = Root.Q("window"); navigation = Root.Q("navigation"); content = Root.Q("contentHost");
+            status = Root.Q<Label>("status"); Root.Q<Button>("closeButton").clicked += Close;
+            var header = Root.Q("header");
+            header.RegisterCallback<PointerDownEvent>(StartDrag);
+            header.RegisterCallback<PointerMoveEvent>(Drag);
+            header.RegisterCallback<PointerUpEvent>(StopDrag);
+            Root.RegisterCallback<GeometryChangedEvent>(GeometryChanged);
+        }
+        internal void PresentNavigation(RuntimeDebugPanelRegistration[] entries, string selectedId)
+        {
+            navigation.Clear();
+            foreach (var entry in entries)
+            {
+                var button = new Button(() => Selected?.Invoke(entry)) { text = entry.Descriptor.Title };
+                button.AddToClassList("rdh-tab"); button.EnableInClassList("rdh-selected", entry.Descriptor.Id == selectedId);
+                navigation.Add(button);
+            }
+        }
+        internal void PresentContent(VisualElement view) { content.Clear(); if (view != null) content.Add(view); }
+        internal void SetPreferredSize(Vector2 size)
+        { window.style.width = Mathf.Max(320, size.x); window.style.height = Mathf.Max(240, size.y); }
+        internal void Report(string value) => status.text = value ?? "";
+        internal void SetVisible(bool visible)
+        { if (!visible) dragging = false; Root.EnableInClassList("rdh-hidden", !visible); }
+        private void Close() => Closed?.Invoke();
+        private void GeometryChanged(GeometryChangedEvent value) => Root.EnableInClassList("rdh-compact", Root.worldBound.width < 700);
+        private void StartDrag(PointerDownEvent value)
+        {
+            var target = value.target as VisualElement;
+            if (value.button != 0 || target is Button || target?.GetFirstAncestorOfType<Button>() != null) return;
+            dragging = true; dragOrigin = value.position;
+            windowOrigin = new Vector2(window.resolvedStyle.translate.x, window.resolvedStyle.translate.y);
+            ((VisualElement)value.currentTarget).CapturePointer(value.pointerId); value.StopPropagation();
+        }
+        private void Drag(PointerMoveEvent value)
+        {
+            if (!dragging) return;
+            Vector2 position = windowOrigin + (Vector2)value.position - dragOrigin;
+            position.x = Mathf.Clamp(position.x, -20, Mathf.Max(-20, Root.worldBound.width - window.layout.width - 30));
+            position.y = Mathf.Clamp(position.y, -20, Mathf.Max(-20, Root.worldBound.height - window.layout.height - 24));
+            window.style.translate = new Translate(position.x, position.y); value.StopPropagation();
+        }
+        private void StopDrag(PointerUpEvent value)
+        { dragging = false; ((VisualElement)value.currentTarget).ReleasePointer(value.pointerId); }
+        protected override void OnDispose()
+        {
+            Root.Q<Button>("closeButton").clicked -= Close;
+            var header = Root.Q("header");
+            header.UnregisterCallback<PointerDownEvent>(StartDrag);
+            header.UnregisterCallback<PointerMoveEvent>(Drag);
+            header.UnregisterCallback<PointerUpEvent>(StopDrag);
+            Root.UnregisterCallback<GeometryChangedEvent>(GeometryChanged);
+            Root.RemoveFromHierarchy(); Closed = null; Selected = null;
+        }
+    }
+}
+#endif
