@@ -0,0 +1,25 @@
+#if UNITY_EDITOR || DEVELOPMENT_BUILD
+using System;
+using UnityEngine;
+namespace GameCore.Debugging
+{
+    /// <summary>调试页的稳定身份与窗口偏好；ID 独立于标题及实现类型，注册后不可修改。</summary>
+    public sealed class RuntimeDebugPanelDescriptor
+    {
+        public string Id { get; }
+        public string Title { get; }
+        public int SortOrder { get; }
+        public Vector2 PreferredSize { get; }
+        public RuntimeDebugPanelDescriptor(string id, string title, int sortOrder = 0, Vector2 preferredSize = default)
+        {
+            if (string.IsNullOrWhiteSpace(id) || id.Length > 128 || string.IsNullOrWhiteSpace(title))
+                throw new ArgumentException("调试页必须有稳定 ID 和标题。");
+            Id = id; Title = title; SortOrder = sortOrder;
+            PreferredSize = preferredSize == default ? new Vector2(720, 600) : preferredSize;
+            if (float.IsNaN(PreferredSize.x) || float.IsNaN(PreferredSize.y) || float.IsInfinity(PreferredSize.x) ||
+                float.IsInfinity(PreferredSize.y) || PreferredSize.x <= 0 || PreferredSize.y <= 0)
+                throw new ArgumentException("调试页参考尺寸必须为有限正数。", nameof(preferredSize));
+        }
+    }
+}
+#endif
diff --git a/Runtime/Debugging/RuntimeDebugPanelRegistration.cs b/Runtime/Debugging/RuntimeDebugPanelRegistration.cs
new file mode 100644
index 0000000..dd48f48
--- /dev/null
+++ b/Runtime/Debugging/RuntimeDebugPanelRegistration.cs
@@ -0,0 +1,57 @@
+#if UNITY_EDITOR || DEVELOPMENT_BUILD
+using System;
+using System.Threading;
+using UnityEngine.UIElements;
+namespace GameCore.Debugging
+{
+    /// <summary>一次注册及懒创建视图的所有者；句柄只影响本代注册，激活取消和最终释放均幂等。</summary>
+    internal sealed class RuntimeDebugPanelRegistration : IDisposable
+    {
+        private readonly Func<IRuntimeDebugPanel> factory;
+        private readonly Action<RuntimeDebugPanelRegistration> unregister;
+        private IRuntimeDebugPanel panel;
+        private VisualElement root;
+        private CancellationTokenSource activation;
+        private bool disposed;
+        internal RuntimeDebugPanelDescriptor Descriptor { get; }
+        internal RuntimeDebugPanelRegistration(RuntimeDebugPanelDescriptor descriptor,
+            Func<IRuntimeDebugPanel> factory, Action<RuntimeDebugPanelRegistration> unregister)
+        { Descriptor = descriptor; this.factory = factory; this.unregister = unregister; }
+        internal VisualElement Activate(RuntimeDebugPanelContext context)
+        {
+            if (disposed) throw new ObjectDisposedException(Descriptor.Id);
+            if (panel == null)
+            {
+                try
+                {
+                    panel = factory() ?? throw new InvalidOperationException("空调试页：" + Descriptor.Id);
+                    root = panel.CreateView(context) ?? throw new InvalidOperationException("调试页没有视图：" + Descriptor.Id);
+                    root.AddToClassList("rdh-panel");
+                }
+                catch { try { panel?.Dispose(); } finally { panel = null; root = null; } throw; }
+            }
+            if (activation == null)
+            {
+                activation = new CancellationTokenSource();
+                try { panel.OnActivated(activation.Token); }
+                catch { Deactivate(); throw; }
+            }
+            return root;
+        }
+        internal void Deactivate()
+        {
+            if (activation == null) return;
+            var previous = activation; activation = null;
+            try { previous.Cancel(); panel?.OnDeactivated(); }
+            finally { previous.Dispose(); root?.RemoveFromHierarchy(); }
+        }
+        public void Dispose()
+        {
+            if (disposed) return;
+            disposed = true;
+            try { unregister(this); }
+            finally { try { Deactivate(); } finally { panel?.Dispose(); panel = null; root = null; } }
+        }
+    }
+}
+#endif
diff --git a/Runtime/Debugging/RuntimeDebugPanelRegistry.cs b/Runtime/Debugging/RuntimeDebugPanelRegistry.cs
new file mode 100644
index 0000000..f58458a
--- /dev/null
+++ b/Runtime/Debugging/RuntimeDebugPanelRegistry.cs
@@ -0,0 +1,34 @@
+#if UNITY_EDITOR || DEVELOPMENT_BUILD
+using System;
+using System.Collections.Generic;
+using System.Linq;
+namespace GameCore.Debugging
+{
+    /// <summary>Hub 的注册作用域；按稳定 ID 判重和排序，旧句柄不能移除后续同名注册。</summary>
+    internal sealed class RuntimeDebugPanelRegistry : IDisposable
+    {
+        private readonly Dictionary<string, RuntimeDebugPanelRegistration> entries =
+            new Dictionary<string, RuntimeDebugPanelRegistration>(StringComparer.Ordinal);
+        internal event Action Changed;
+        internal RuntimeDebugPanelRegistration[] Entries => entries.Values.OrderBy(p => p.Descriptor.SortOrder)
+            .ThenBy(p => p.Descriptor.Id, StringComparer.Ordinal).ToArray();
+        internal IDisposable Register(RuntimeDebugPanelDescriptor descriptor, Func<IRuntimeDebugPanel> factory)
+        {
+            if (descriptor == null || factory == null) throw new ArgumentNullException(nameof(descriptor));
+            if (entries.ContainsKey(descriptor.Id)) throw new InvalidOperationException("重复调试页 ID：" + descriptor.Id);
+            var entry = new RuntimeDebugPanelRegistration(descriptor, factory, Remove);
+            entries.Add(descriptor.Id, entry); Changed?.Invoke(); return entry;
+        }
+        private void Remove(RuntimeDebugPanelRegistration entry)
+        {
+            if (!entries.TryGetValue(entry.Descriptor.Id, out var current) || !ReferenceEquals(current, entry)) return;
+            entries.Remove(entry.Descriptor.Id); Changed?.Invoke();
+        }
+        public void Dispose()
+        {
+            foreach (var entry in Entries) entry.Dispose();
+            entries.Clear(); Changed = null;
+        }
+    }
+}
+#endif
