+            byte hasBusiness = reader.ReadByte(); GridBusinessState? business = null;
+            if (known > 1 || hasBusiness > 1 || (tile == 0 && (height != 0 || flags != 0 || hasBusiness != 0)) ||
+                (known == 0 && (tile != 0 || height != 0 || flags != 0 || hasBusiness != 0 || version != 0)))
