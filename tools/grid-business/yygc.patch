+        private static void WriteCell(BinaryWriter writer, WireCell cell)
+        {
+            writer.Write(cell.Index); writer.Write(cell.Known); writer.Write(cell.Value.TileId);
+            writer.Write(cell.Value.Height); writer.Write(cell.Value.Flags); writer.Write(cell.ContentVersion);
