         private static byte[] Exact(BinaryReader r, int length) { byte[] bytes = r.ReadBytes(length); if (bytes.Length != length) throw new EndOfStreamException(); return bytes; }
         private static void Guid(BinaryWriter w, StableGuid id) { byte[] bytes = new byte[16]; id.WriteCanonicalBytes(bytes); w.Write(bytes); }
         private static StableGuid Guid(BinaryReader r) => StableGuid.FromCanonicalBytes(Exact(r, 16));
