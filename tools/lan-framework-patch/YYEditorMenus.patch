@@ -0,0 +1,57 @@
+using GameCore.Editor.NetworkCommands;
+using GameCore.Editor.Objects;
+using GameCore.Editor.Objects.Definition;
+using GameCore.Editor.Objects.NetworkStates;
+using GameCore.Editor.Objects.Runner;
+using GameCore.Objects.Definition;
+using GameCore.Objects.Editor.Singletons;
+using Plugins.YYToolkits.Databases;
+using Runtime.AppStartup.Editor;
+using UnityEditor;
+
+namespace GameCore.Editor
+{
+    /// <summary>
+    /// 注册 YYGC 的顶部编辑器菜单。实现留在各自工具内，自动注册与其他调用入口不依赖菜单。
+    /// </summary>
+    public static class YYMenu
+    {
+        private const string Root = "YY/";
+
+        [MenuItem(Root + "Objects/Open Suite", priority = 0)]
+        private static void OpenSuite() => ObjectManagerSuite.OpenSuite();
+        [MenuItem(Root + "Objects/Open Workshop", priority = 1)]
+        private static void OpenWorkshop() => ObjectDefinitionWorkshopWindow.OpenWindow();
+        [MenuItem(Root + "Objects/Definition Viewer", priority = 2)]
+        private static void OpenDefinitions() => ObjectDefinitionViewer.ShowWindow();
+        [MenuItem(Root + "Objects/Singleton Manager", priority = 3)]
+        private static void OpenSingletons() => ObjectSingletonEditorWindow.ShowWindow();
+        [MenuItem(Root + "Objects/Archetype Manager", priority = 4)]
+        private static void OpenArchetypes() => ObjectArchetypeManagerWindow.ShowWindow();
+        [MenuItem(Root + "Objects/DI Debug Window", priority = 5)]
+        private static void OpenDiDebug() => ObjectManagerSuite.OpenDIDebugWindow();
+        [MenuItem(Root + "Objects/App Startup", priority = 6)]
+        private static void OpenAppStartup() => AppStartupSettingsWindow.ShowWindow();
+
+        [MenuItem(Root + "Definitions/Key 搜索与调试")]
+        private static void SearchDefinitionKey() => DefinitionLookupWindow.Open();
+        [MenuItem(Root + "Definitions/GUID 与 Key 迁移")]
+        private static void MigrateDefinitionIdentity() => DefinitionMigrationWindow.Open(ObjectDefinitionDatabase.Instance);
+
+        [MenuItem(Root + "NetworkCommands/Discover and Update `NetworkCommand` Registry")]
+        private static void DiscoverCommands() => NetworkCommandInterfaceGenerator.DiscoverAndRegisterNetworkCommands();
+        [MenuItem(Root + "NetworkCommands/Generate `NetworkCommand` Registry Source")]
+        private static void GenerateCommands() => NetworkCommandInterfaceGenerator.GenerateUnions();
+        [MenuItem(Root + "Networking/Check Command Dependency")]
+        private static void CheckCommandDependency() => NetworkCommandDependencyValidator.Validate();
+        [MenuItem(Root + "State Datas/Update Registry and Generate Mappings")]
+        private static void UpdateStates() => StateDataRegistryUpdater.UpdateRegistryAndGenerateMappings();
+        [MenuItem(Root + "State Datas/Generate State Data Registry Source")]
+        private static void GenerateStates() => StateDataInterfaceGenerator.GenerateUnions();
+
+        [MenuItem(Root + "Tools/Map Generator (User Version)")]
+        private static void OpenMapGenerator() => WorldGeneratorEditorWindow.ShowWindow();
+        [MenuItem(Root + "Tools/Update All SODatabases")]
+        private static void UpdateDatabases() => SODatabaseUpdater.UpdateAllSODatabases();
+    }
+}
