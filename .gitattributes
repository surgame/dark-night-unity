* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
# Frozen cross-engine evidence retains the exact original bytes, including line endings.
tools/CoreRegression/Fixtures/*.json -text whitespace=cr-at-eol
*.cs text eol=lf
*.ps1 text eol=lf
# Unified patches preserve a leading space on blank context lines.
*.patch text eol=lf whitespace=-blank-at-eol
*.asmdef text eol=lf
*.asmref text eol=lf
# Unity emits trailing spaces for empty importer fields; preserve generated metadata.
*.meta text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf
*.prefab text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.dll binary
