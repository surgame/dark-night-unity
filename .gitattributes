* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
# Frozen cross-engine evidence retains the exact original bytes, including line endings.
tools/CoreRegression/Fixtures/*.json -text whitespace=cr-at-eol
tools/terrain-modifiers/reference/*.js -text whitespace=cr-at-eol
docs/evidence/terrain-modifiers-2026-09-22/* -text whitespace=cr-at-eol
docs/evidence/terrain-scene-catalog-20260926.xml -text whitespace=cr-at-eol
*.cs text eol=lf
*.ps1 text eol=lf
# Unified patches preserve a leading space on blank context lines.
*.patch text eol=lf whitespace=-blank-at-eol
*.asmdef text eol=lf
*.asmref text eol=lf
# Unity emits trailing spaces for empty importer fields; preserve generated metadata.
*.meta text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.anim text eol=lf whitespace=-blank-at-eol
*.mat text eol=lf whitespace=-blank-at-eol
*.fontsettings text eol=lf whitespace=-blank-at-eol
# The original art manifest and media retain their frozen source bytes.
Game/Assets/DarkNights/Res/Art/Original/manifest.json -text whitespace=cr-at-eol
*.shader text eol=lf
*.hlsl text eol=lf
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.dll binary
