<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
  <ui:Style src="FlashlightDebug.uss" />
  <ui:ScrollView class="light-panel">
    <ui:Label name="status" class="status" />
    <uie:ObjectField name="definition" label="物体 Definition" />
    <uie:ObjectField name="profile" label="LightProfile 预设" />
    <uie:ObjectField name="runtimeTool" label="运行手电实例" />
    <ui:Button name="chooseRuntime" text="选择当前运行中的手电" />
    <ui:VisualElement class="preset-row">
      <ui:Button name="saveDefinition" text="确认保存到 Definition" />
      <ui:Button name="saveProfile" text="确认保存到共享预设" />
      <ui:Button name="openProfile" text="定位预设" />
    </ui:VisualElement>
    <ui:Button name="resetRuntime" text="撤掉单灯临时覆盖" />
    <ui:VisualElement class="preset-row">
      <ui:Button name="undoRuntime" text="撤销临时调整" />
      <ui:Button name="redoRuntime" text="重做临时调整" />
    </ui:VisualElement>
    <ui:VisualElement name="parameters" />
    <ui:Foldout text="灯口临时调整（确认保存才写入 Prefab）" value="true">
      <ui:VisualElement name="mount" />
    </ui:Foldout>
    <ui:Foldout text="场景光照临时调整" value="false">
      <uie:ObjectField name="sceneProfile" label="场景光照配置" />
      <ui:VisualElement name="sceneParameters" />
      <ui:Button name="saveSceneProfile" text="确认保存到场景光照资产" />
    </ui:Foldout>
  </ui:ScrollView>
</ui:UXML>
