<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="TerrainWorkbench.uss" />
  <ui:VisualElement name="mapWorkbench" class="dn-map-workbench">
    <ui:VisualElement class="map-header">
      <ui:VisualElement class="map-document">
        <ui:Label text="矿洞地图工作台" class="map-title" />
        <ui:Label name="documentSource" class="map-secondary" />
      </ui:VisualElement>
      <ui:VisualElement name="headerActions" class="map-row map-header-actions">
        <ui:Label name="draftStatus" class="map-header-status" />
        <ui:Button name="saveDraft" text="保存地图草稿" tooltip="保存作者输入；不会自动更换正式新局引用。Ctrl+S 保存当前任务的草稿。" />
        <ui:Button name="updateCandidate" text="生成 / 更新候选" tooltip="按当前草稿重建完整候选，不保存草稿、不更换正式引用。" class="map-primary" />
      </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="editSurface" class="map-work-area">
      <ui:ScrollView name="taskNavigation" class="map-navigation" />
      <ui:TwoPaneSplitView name="mapSplit" fixed-pane-index="1" fixed-pane-initial-dimension="360">
        <ui:VisualElement class="map-center">
          <ui:VisualElement class="map-view-toolbar">
            <ui:VisualElement class="map-row map-view-switch">
              <ui:Button name="viewCandidate" text="草稿候选" />
              <ui:Button name="viewInstalled" text="正式新局" tooltip="只读查看当前正式新局引用，不更换引用。" />
            </ui:VisualElement>
            <ui:Label name="candidateStatus" class="map-toolbar-status" />
            <ui:Button name="fitCanvas" text="适配画布" tooltip="重置缩放与平移，不修改地图。" />
          </ui:VisualElement>
          <ui:VisualElement class="map-layer-toolbar">
            <ui:Label text="叠层" class="map-toolbar-caption" />
            <ui:VisualElement name="canvasTools" class="map-canvas-toolbar" />
          </ui:VisualElement>
          <ui:Label name="canvasIdentity" class="map-canvas-identity" />
          <ui:VisualElement name="canvasHost" class="map-canvas" />
          <ui:VisualElement class="map-canvas-statusbar">
            <ui:Label text="拖拽平移 · 滚轮缩放" class="map-secondary" tooltip="中键始终平移；1 切逻辑格 / 2 切渲染格；取点时 Esc 取消。" />
            <ui:Label name="canvasStatus" class="map-secondary" />
          </ui:VisualElement>
          <ui:VisualElement class="map-mapinfo">
            <ui:Label name="mapSummary" class="map-summary" />
            <ui:Label name="newGameReference" class="map-reference" />
          </ui:VisualElement>
          <ui:Foldout text="图例与显示说明" value="false" class="map-legend-fold">
            <ui:Label name="canvasLegend" class="map-canvas-legend" />
          </ui:Foldout>
          <ui:Label name="referenceWarning" class="map-reference-warning map-hidden" />
        </ui:VisualElement>
        <ui:VisualElement class="map-inspector">
          <ui:VisualElement class="map-inspector-header">
            <ui:Label text="当前任务" class="map-eyebrow" />
            <ui:Label name="inspectorTitle" class="map-page-title" />
            <ui:Label name="inspectorDescription" class="map-page-description" />
          </ui:VisualElement>
          <ui:ScrollView name="taskProperties" class="map-properties" />
          <ui:VisualElement class="map-task-footer">
            <ui:Button name="previousTask" />
            <ui:Button name="nextTask" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:TwoPaneSplitView>
    </ui:VisualElement>
    <ui:Label name="workbenchNotice" class="map-notice" />
  </ui:VisualElement>
</ui:UXML>
