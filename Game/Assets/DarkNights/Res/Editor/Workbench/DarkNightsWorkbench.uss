.dn-workbench { flex-grow: 1; color: rgb(218, 222, 228); background-color: rgb(42, 44, 48); }
.dn-shell { flex-grow: 1; }
.dn-header { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 10px 12px; background-color: rgb(32, 34, 38); border-bottom-width: 1px; border-bottom-color: rgb(62, 66, 73); }
.dn-brand { -unity-font-style: bold; font-size: 14px; margin-right: 18px; }
.dn-tabs { flex-direction: row; flex-wrap: wrap; flex-grow: 1; }
.dn-tab { min-height: 30px; flex-grow: 1; margin: 2px; padding: 4px 10px; }
.dn-tab-active { background-color: rgb(55, 87, 110); color: rgb(243, 246, 250); border-bottom-color: rgb(111, 173, 213); border-bottom-width: 2px; }
.dn-scene-shortcuts { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 6px 12px; background-color: rgb(37, 39, 43); }
.dn-scene-button { min-height: 25px; margin-left: 5px; }
.dn-current-scene { border-left-width: 3px; border-left-color: rgb(111, 173, 213); }
.dn-task-content { flex-grow: 1; padding: 12px; }
.dn-page-title { font-size: 17px; -unity-font-style: bold; margin-bottom: 10px; }
.dn-tool-row { flex-direction: row; align-items: center; padding: 10px; margin-bottom: 6px; background-color: rgb(48, 51, 57); border-radius: 4px; }
.dn-entry-info { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.dn-entry-title { -unity-font-style: bold; margin-bottom: 4px; }
.dn-description { white-space: normal; color: rgb(181, 190, 201); margin-bottom: 4px; }
.dn-native-action { min-height: 28px; margin: 3px 6px; padding: 3px 10px; }
.dn-definition-shortcuts, .dn-actions { flex-direction: row; flex-wrap: wrap; margin-top: 5px; margin-bottom: 8px; }
.dn-mining-panel { margin-top: 7px; padding: 8px; background-color: rgb(37, 40, 45); }
.dn-mining-panel .unity-help-box { margin-top: 7px; margin-bottom: 7px; }
.dn-sources { padding: 10px; margin-top: 8px; background-color: rgb(37, 40, 45); }
.dn-sources > .unity-label { -unity-font-style: bold; margin-bottom: 8px; }
.dn-sources .unity-popup-field { margin-bottom: 8px; }
.dn-all-scenes { padding: 6px 12px; border-top-width: 1px; border-top-color: rgb(62, 66, 73); }
.dn-all-scenes .dn-launcher { max-height: 270px; }
.dn-all-scenes .dn-page-title, .dn-all-scenes .dn-launcher > .dn-description { display: none; }
.dn-launcher { flex-grow: 1; min-height: 100px; }
.dn-launcher-content { flex-grow: 1; }
.dn-filters { flex-direction: row; flex-wrap: wrap; margin-top: 6px; margin-bottom: 8px; }
.dn-chip { min-height: 24px; margin: 2px 4px; }
.dn-chip-active { background-color: rgb(55, 87, 110); color: rgb(243, 246, 250); }
.dn-section-title { -unity-font-style: bold; margin: 8px 0; }
.dn-scene-row { flex-direction: row; align-items: center; padding: 9px; margin-bottom: 5px; background-color: rgb(48, 51, 57); }
.dn-path { white-space: normal; color: rgb(166, 178, 194); font-size: 11px; }
.dn-empty { white-space: normal; padding: 18px; }
.dn-status { white-space: normal; padding: 8px 12px; background-color: rgb(32, 34, 38); color: rgb(181, 190, 201); border-top-width: 1px; border-top-color: rgb(62, 66, 73); }
.dn-muted { color: rgb(181, 190, 201); }
.dn-compact .dn-header { flex-direction: column; align-items: stretch; }
.dn-compact .dn-brand { margin-bottom: 6px; }
.dn-compact .dn-tool-row, .dn-compact .dn-scene-row { flex-direction: column; align-items: stretch; }
.dn-compact .dn-native-action { margin-top: 8px; }
.dn-light { color: rgb(35, 44, 53); background-color: rgb(233, 237, 242); }
.dn-light .dn-header, .dn-light .dn-status { background-color: rgb(215, 222, 230); border-bottom-color: rgb(186, 194, 204); border-top-color: rgb(186, 194, 204); }
.dn-light .dn-scene-shortcuts { background-color: rgb(224, 229, 236); }
.dn-light .dn-tool-row, .dn-light .dn-scene-row { background-color: rgb(247, 249, 252); }
.dn-light .dn-sources, .dn-light .dn-mining-panel { background-color: rgb(225, 232, 239); }
.dn-light .dn-description, .dn-light .dn-status, .dn-light .dn-muted, .dn-light .dn-path { color: rgb(72, 88, 108); }
.dn-light .dn-tab-active, .dn-light .dn-chip-active { background-color: rgb(190, 215, 235); color: rgb(24, 49, 70); }
