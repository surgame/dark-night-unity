.dn-workbench { flex-grow: 1; background-color: rgb(32, 35, 40); color: rgb(220, 224, 231); }
.dn-shell { flex-grow: 1; min-height: 0; }
.dn-header { flex-direction: row; align-items: center; justify-content: space-between; min-height: 76px; padding: 12px 20px; background-color: rgb(39, 43, 50); border-bottom-width: 1px; border-bottom-color: rgb(64, 70, 80); }
.dn-brand { min-width: 160px; }
.dn-brand-name { height: 25px; font-size: 19px; -unity-font-style: bold; color: rgb(235, 239, 245); }
.dn-brand-subtitle { height: 16px; font-size: 11px; color: rgb(150, 167, 185); margin-top: 3px; }
.dn-tabs { flex-direction: row; }
.dn-workbench Button { min-height: 27px; border-radius: 4px; padding: 5px 12px; margin: 2px; }
.dn-workbench .dn-tab { min-width: 112px; min-height: 36px; background-color: rgb(48, 53, 61); color: rgb(194, 204, 216); border-width: 0; margin-left: 5px; }
.dn-tab:hover { background-color: rgb(60, 67, 78); }
.dn-workbench .dn-tab-active { background-color: rgb(50, 83, 108); color: rgb(235, 246, 255); border-bottom-width: 2px; border-bottom-color: rgb(124, 192, 225); -unity-font-style: bold; }
.dn-search-row { flex-direction: row; align-items: center; padding: 8px 18px; border-bottom-width: 1px; border-bottom-color: rgb(59, 65, 73); }
#workbench-search { flex-grow: 1; max-width: 560px; margin-left: 12px; margin-right: 8px; }
#editor-body, #launcher-body { flex-grow: 1; min-height: 0; }
.dn-navigation { min-width: 165px; padding: 10px 8px; background-color: rgb(36, 39, 45); }
.dn-details { min-width: 430px; padding: 16px 22px 20px; }
.dn-workbench .dn-editor-link { align-items: flex-start; white-space: normal; min-height: 56px; margin-bottom: 6px; border-width: 0; background-color: rgb(43, 47, 54); color: rgb(215, 222, 231); }
.dn-editor-link:hover { background-color: rgb(54, 62, 72); }
.dn-editor-link .dn-muted { font-size: 10px; margin-top: 5px; }
.dn-workbench .dn-editor-link-active { background-color: rgb(45, 68, 85); border-left-width: 3px; border-left-color: rgb(124, 192, 225); }
.dn-page-title { font-size: 22px; -unity-font-style: bold; margin-bottom: 8px; }
.dn-description { white-space: normal; color: rgb(181, 190, 203); font-size: 12px; margin-bottom: 7px; }
.dn-save-hint { white-space: normal; font-size: 11px; color: rgb(147, 166, 184); margin-top: 4px; margin-bottom: 12px; }
.dn-muted { color: rgb(157, 172, 188); }
.dn-status { padding: 7px 20px; font-size: 11px; color: rgb(155, 173, 192); border-top-width: 1px; border-top-color: rgb(59, 65, 73); white-space: normal; }
.dn-launcher { flex-grow: 1; min-height: 0; padding: 18px 22px 0; }
.dn-launcher-content { flex-grow: 1; min-height: 0; padding-bottom: 18px; }
.dn-filters { flex-direction: row; flex-wrap: wrap; margin-top: 2px; margin-bottom: 14px; }
.dn-chip { border-width: 0; background-color: rgb(44, 49, 57); color: rgb(178, 192, 209); }
.dn-chip-active { background-color: rgb(49, 79, 100); color: rgb(230, 246, 255); }
.dn-section-title { -unity-font-style: bold; font-size: 13px; color: rgb(156, 184, 206); margin: 10px 0 8px; }
.dn-scene-row { flex-direction: row; align-items: center; padding: 12px 14px; margin-bottom: 7px; border-radius: 5px; border-width: 1px; border-color: rgb(56, 64, 73); background-color: rgb(40, 45, 52); }
.dn-entry-info { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.dn-entry-title { font-size: 14px; -unity-font-style: bold; margin-bottom: 6px; }
.dn-path { font-size: 10px; color: rgb(131, 149, 168); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dn-current-scene { border-left-width: 3px; border-left-color: rgb(124, 192, 225); }
.dn-actions { flex-direction: row; flex-wrap: wrap; align-items: center; margin-left: 14px; flex-shrink: 0; }
.dn-primary { background-color: rgb(50, 90, 120); color: rgb(236, 247, 255); border-width: 1px; border-color: rgb(77, 119, 149); }
.dn-primary:hover { background-color: rgb(64, 112, 145); }
.dn-primary:disabled { opacity: 0.45; }
.dn-secondary { color: rgb(178, 191, 206); }
.dn-tool-grid { flex-direction: row; flex-wrap: wrap; }
.dn-tool-card { width: 47%; min-width: 300px; padding: 20px; margin: 0 12px 12px 0; background-color: rgb(40, 45, 52); border-width: 1px; border-color: rgb(56, 64, 73); border-radius: 6px; }
.dn-tool-card .dn-entry-title { font-size: 18px; margin-bottom: 12px; }
.dn-tool-card .dn-actions { margin-left: 0; margin-top: 12px; }
.dn-section-foldout { margin-top: 10px; margin-bottom: 5px; }
.dn-section-foldout > .unity-foldout__toggle { font-size: 13px; -unity-font-style: bold; margin-bottom: 8px; }
.dn-sources { margin-top: 6px; }
.dn-empty { padding: 35px 20px; white-space: normal; color: rgb(172, 186, 203); }
.dn-asset-area { margin-top: 12px; }
.dn-asset-area .dn-actions { margin-left: 0; margin-top: 8px; margin-bottom: 12px; }
.dn-details .unity-help-box { margin-top: 8px; margin-bottom: 10px; }
.dn-details .unity-base-field { margin-top: 4px; margin-bottom: 4px; }
.dn-details .unity-foldout { margin-top: 8px; margin-bottom: 8px; }
.dn-browser-body { flex-direction: row; align-items: flex-start; margin-top: 12px; }
.dn-browser-list { width: 260px; flex-shrink: 0; margin-right: 20px; }
.dn-browser-list .unity-list-view { height: 420px; background-color: rgba(90, 120, 145, 0.09); }
.dn-browser-list .unity-list-view__item { padding-left: 8px; padding-right: 8px; }
.dn-browser-list Label { white-space: normal; }
.dn-browser-editor { flex-grow: 1; flex-shrink: 1; min-width: 350px; }
.dn-browser-compact .dn-browser-body { flex-direction: column; align-items: stretch; }
.dn-browser-compact .dn-browser-list { width: 100%; margin-right: 0; margin-bottom: 14px; }
.dn-browser-compact .dn-browser-list .unity-list-view { height: 190px; }
.dn-browser-compact .dn-browser-editor { min-width: 0; }
.dn-mining-tabs { margin-top: 14px; margin-bottom: 12px; height: 34px; background-color: rgba(90, 120, 145, 0.09); }
.dn-mining-tabs .unity-toolbar-button { flex-grow: 1; min-width: 100px; -unity-text-align: middle-center; }
.dn-mining-tabs .dn-chip-active { border-bottom-width: 2px; border-bottom-color: rgb(105, 165, 201); }
.dn-compact .dn-scene-row { flex-direction: column; align-items: stretch; }
.dn-compact .dn-scene-row .dn-actions { margin-left: 0; margin-top: 8px; }
.dn-compact .dn-tool-card { width: 100%; margin-right: 0; }
.dn-compact .dn-header { padding-left: 14px; padding-right: 14px; }
.dn-light { background-color: rgb(237, 240, 244); color: rgb(40, 49, 62); }
.dn-light .dn-header { background-color: rgb(224, 231, 238); border-bottom-color: rgb(183, 197, 212); }
.dn-light .dn-brand-name { color: rgb(32, 53, 73); }
.dn-light .dn-brand-subtitle, .dn-light .dn-muted, .dn-light .dn-description, .dn-light .dn-save-hint, .dn-light .dn-path, .dn-light .dn-status, .dn-light .dn-secondary { color: rgb(82, 103, 122); }
.dn-light .dn-navigation { background-color: rgb(226, 232, 239); }
.dn-light .dn-editor-link, .dn-light .dn-tab, .dn-light .dn-chip { background-color: rgb(211, 222, 232); color: rgb(47, 67, 85); }
.dn-light .dn-editor-link:hover, .dn-light .dn-tab:hover { background-color: rgb(194, 212, 229); }
.dn-light .dn-editor-link-active, .dn-light .dn-tab-active, .dn-light .dn-chip-active { background-color: rgb(178, 205, 225); color: rgb(31, 61, 85); }
.dn-light .dn-scene-row, .dn-light .dn-tool-card { background-color: rgb(249, 251, 253); border-color: rgb(202, 214, 226); }
.dn-light .dn-section-title { color: rgb(64, 99, 125); }
.dn-light .dn-empty { color: rgb(82, 103, 122); }
