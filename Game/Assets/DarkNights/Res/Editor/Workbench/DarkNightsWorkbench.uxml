<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="DarkNightsWorkbench.uss" />
    <ui:VisualElement class="dn-shell">
        <ui:VisualElement class="dn-header">
            <ui:Label text="DARK NIGHTS" class="dn-brand" />
            <ui:VisualElement class="dn-tabs">
                <ui:Button name="workspace-objects" text="对象与装备" class="dn-tab" />
                <ui:Button name="workspace-journey" text="星球与航程" class="dn-tab" />
                <ui:Button name="workspace-map" text="地图与表现" class="dn-tab" />
                <ui:Button name="workspace-ui" text="界面资源" class="dn-tab" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="scene-shortcuts" class="dn-scene-shortcuts">
            <ui:Label text="场景" class="dn-muted" />
        </ui:VisualElement>
        <ui:HelpBox name="workbench-error" message-type="Error" />
        <ui:ScrollView name="task-content" class="dn-task-content" />
        <ui:Foldout name="all-scenes" text="全部场景与测试" value="false" class="dn-all-scenes" />
        <ui:Label name="workbench-status" class="dn-status" />
    </ui:VisualElement>
</ui:UXML>
