.dn-objects-panel { flex-shrink: 0; }
.dn-objects-toolbar { flex-direction: row; flex-wrap: wrap; align-items: center; margin-bottom: 12px; }
.dn-objects-search { flex-grow: 1; flex-basis: 170px; margin-right: 12px; }
.dn-objects-target { width: 190px; margin-right: 12px; }
.dn-objects-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-bottom: 2px; }
.rdh-panel .dn-objects-tile { width: 48px; height: 48px; flex-shrink: 0; margin: 0 6px 6px 0; padding: 0; align-items: center; justify-content: center; }
.dn-objects-icon { width: 32px; height: 32px; }
.dn-objects-missing-icon { color: #acb6bf; font-size: 22px; }
.rdh-panel .dn-objects-tile:focus { border-color: #62878d; }
.rdh-panel .dn-objects-tile.dn-objects-selected { background-color: #273e43; border-color: #92d7df; }
.rdh-panel .dn-objects-tile.dn-objects-selected:hover { background-color: #304b51; }
.dn-objects-selection { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 10px; margin-bottom: 14px; }
.dn-objects-selected-info { flex-grow: 1; flex-basis: 140px; margin-right: 10px; }
.dn-objects-quantity { width: 96px; margin-right: 10px; }
.dn-objects-instance { width: 100px; margin-right: 10px; }
.dn-objects-selection Button { margin-right: 6px; }
.dn-objects-equipment-title { flex-direction: row; justify-content: space-between; margin-bottom: 8px; }
.dn-objects-slots { flex-direction: row; flex-wrap: wrap; }
.dn-objects-slot { flex-grow: 1; flex-basis: 120px; min-height: 94px; margin: 0 6px 6px 0; padding: 9px; border-width: 1px; border-color: #424950; border-radius: 6px; background-color: #292d32; }
.dn-objects-slot Label { margin-bottom: 6px; }
.dn-objects-slot Button { margin-top: auto; }
.dn-objects-jetpack { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 9px; border-width: 1px; border-color: #424950; border-radius: 6px; background-color: #292d32; margin-top: 3px; margin-bottom: 8px; }
.dn-objects-jetpack Label { margin-right: 8px; }
.dn-objects-jetpack Button { margin-left: auto; }
