  "selections": [
    {
      "map": "advanced",
      "room": "A01",
      "detail": "A01 分流洞厅：入洞不久便可选择右侧下探或左侧浅矿支洞。"
    },
    {
      "map": "advanced",
      "room": "A02",
      "detail": "A02 长檐采台：采台右端同时露出上折小矿窝和下探岩口。"
    },
    {
      "map": "advanced",
      "room": "A03",
      "detail": "A03 转层岔厅：向左进入第二层，向下是独立的侧洞采区。"
    },
    {
      "map": "advanced",
      "room": "A04",
      "detail": "A04 低檐矿室：宽台与较低岩檐形成短停留点，承接下一次选择。"
    },
    {
      "map": "advanced",
      "room": "A05",
      "detail": "A05 双口岩厅：左侧进入可再分段探索的支洞，下口继续主干。"
    },
    {
      "map": "advanced",
      "room": "A06",
      "detail": "A06 错肩下探：用短斜颈衔接相邻层次，抵达后即有落脚空间。"
    },
    {
      "map": "advanced",
      "room": "A07",
      "detail": "A07 菌根岔台：小矿窝与深部入口在不同高度，选择会影响这一趟的探索范围。"
    },
    {
      "map": "advanced",
      "room": "A08",
      "detail": "A08 裂颈矿厅：收窄段位于宽厅之前，保留塌方候选插槽。"
    },
    {
      "map": "advanced",
      "room": "A09",
      "detail": "A09 深部富矿厅：主干最深折返点，厚矿体位于壁内。"
    },
    {
      "map": "advanced",
      "room": "A10",
      "detail": "A10 浅岔石台：第一条支路在这里再次分岔，两个终点各有内容。"
    },
    {
      "map": "advanced",
      "room": "A11",
      "detail": "A11 左下矿窝：较短的浅支路终点，提供早期折返选择。"
    },
    {
      "map": "advanced",
      "room": "A12",
      "detail": "A12 菌根小厅：向下延伸的浅层支洞终点，和左侧矿窝形成路线选择。"
    },
    {
      "map": "advanced",
      "room": "A13",
      "detail": "A13 高檐露矿：从长檐采台上折的近处小矿窝。"
    },
    {
      "map": "advanced",
      "room": "A14",
      "detail": "A14 侧巢岔室：进入支洞后仍有一段侧向延伸，矿与巢位分开标记。"
    },
    {
      "map": "advanced",
      "room": "A15",
      "detail": "A15 壁后矿窝：接在侧巢之后的可选矿室，玩家自行决定是否抵达。"
    },
    {
      "map": "advanced",
      "room": "A16",
      "detail": "A16 左翼岩厅：与主干同层的另一路探索，转向后暂时离开主干地标。"
    },
    {
      "map": "advanced",
      "room": "A17",
      "detail": "A17 下折矿窝：左翼支洞的第二段终点，返程经过原岔厅。"
    },
    {
      "map": "advanced",
      "room": "A18",
      "detail": "A18 贴壁小窝：紧贴主干的短支路，和较长支洞形成节奏差。"
    },
    {
      "map": "expert",
      "room": "B01",
      "detail": "B01 洞口分流厅：浅层已经分向左右，两侧的探索规模不同。"
    },
    {
      "map": "expert",
      "room": "B02",
      "detail": "B02 上层岔台：侧支在主干下方再次展开，入口互相错层。"
    },
    {
      "map": "expert",
      "room": "B03",
      "detail": "B03 悬檐转厅：右端小窝与继续下探在不同位置，构成上层末端选择。"
    },
    {
      "map": "expert",
      "room": "B04",
      "detail": "B04 第二层岩厅：完成短下探即进入较宽洞厅，开始向左回折。"
    },
    {
      "map": "expert",
      "room": "B05",
      "detail": "B05 中层三口厅：向左继续、向下试探近处支室；上层支洞在附近但隔着岩层。"
    },
    {
      "map": "expert",
      "room": "B06",
      "detail": "B06 横脉采厅：较平直的有效采区，连接下一处短换层口。"
    },
    {
      "map": "expert",
      "room": "B07",
      "detail": "B07 左翼分岔厅：左翼支洞会连续再分岔，主干则向右进入更深层。"
    },
    {
      "map": "expert",
      "room": "B08",
      "detail": "B08 错肩矿台：短错台后仍有采矿位置，避免层间只承担赶路。"
    },
    {
      "map": "expert",
      "room": "B09",
      "detail": "B09 双岩颈厅：向右为独立侧巢采区，下口通往深层。"
    },
    {
      "map": "expert",
      "room": "B10",
      "detail": "B10 深层转厅：较大岩厅承担方向重建，随后向左进入最终采区。"
    },
    {
      "map": "expert",
      "room": "B11",
      "detail": "B11 长脉矿室：深层仍保留一段可停留采集的宽台。"
