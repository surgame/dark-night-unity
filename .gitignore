# The single Unity project lives below this repository root. Keep generated
# state ignored there while leaving future sibling folders such as Server
# available for their own source files.
/Game/[Ll]ibrary/
/Game/[Tt]emp/
/Game/[Oo]bj/
/Game/[Ll]ogs/
/Game/[Uu]ser[Ss]ettings/
/Game/[Bb]uild/
/Game/[Bb]uilds/
/Game/[Aa]rtifacts/
/Game/ServerData/
/Game/Assets/AddressableAssetsData/*/*.bin*
/Game/Assets/AddressableAssetsData/*/*.hash*
/Game/*.csproj
/Game/*.sln
/Game/*.slnx
/Game/*.unityproj

# Machine-local dependencies and IDE files
/.deps/
# Ignore IDE metadata in the repository root and in nested projects (for
# example, the Unity project under Game/).
**/.vs/
**/.idea/
**/.vscode/
/*.csproj
/*.sln
/*.slnx
/*.unityproj
*.user
*.suo
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.pdb.meta
*.mdb.meta
*.opendb
*.VC.db
*.local.json
